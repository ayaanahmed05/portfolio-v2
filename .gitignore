# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js & build outputs
/.next/
/out/
/build
/.cache

# misc / system
.DS_Store
*.pem
*.log
.eslintcache

# IDE / Editor configs
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files (never commit real secrets)
.env
.env*.local
!.env.example

# vercel deployment
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts